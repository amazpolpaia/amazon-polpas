# Local: copie para .env
# Nuvem (Railway/Render): configure no painel do hospedeiro

# Banco local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=amazon_polpas
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Banco na nuvem (Railway preenche automaticamente ao vincular PostgreSQL)
# DATABASE_URL=postgresql://usuario:senha@host:5432/railway

# E-mail do administrador principal (sempre pode gerenciar usuários)
# ADMIN_MASTER_EMAIL=igor.queiroz@amazonpolpas.com.br

# JWT — string longa e aleatoria (obrigatorio em producao)
JWT_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria
JWT_EXPIRES_IN=8h

# Servidor
PORT=3000
NODE_ENV=development
